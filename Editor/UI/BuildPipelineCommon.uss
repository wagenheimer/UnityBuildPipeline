/* Unity Build Pipeline Common UI Toolkit Stylesheet */

.bp-root {
    flex-grow: 1;
    padding: 10px 12px;
}

/* Header */
.bp-header {
    margin-bottom: 8px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.12);
}

.bp-header-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.bp-header-left {
    flex-direction: row;
    align-items: center;
}

.bp-header-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #3498db;
}

.bp-header-version {
    font-size: 11px;
    color: #aaaaaa;
    margin-left: 8px;
    padding: 2px 7px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
}

.bp-header-meta {
    font-size: 11px;
    color: #888888;
    margin-top: 3px;
}

.bp-toolbar-actions {
    flex-direction: row;
    align-items: center;
}

.bp-toolbar-btn {
    height: 24px;
    padding: 0 10px;
    font-size: 11px;
    margin-left: 5px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    color: #dddddd;
}

.bp-toolbar-btn:hover {
    background-color: rgba(255, 255, 255, 0.14);
    color: #ffffff;
}

/* Save Status Bar */
.bp-save-status {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px;
    margin-bottom: 8px;
    border-radius: 4px;
    background-color: rgba(46, 204, 113, 0.12);
    border-width: 1px;
    border-color: rgba(46, 204, 113, 0.3);
}

.bp-save-status--dirty {
    background-color: rgba(230, 126, 34, 0.15);
    border-color: rgba(230, 126, 34, 0.4);
}

.bp-save-status-text {
    font-size: 11px;
    -unity-font-style: bold;
    color: #e6e6e6;
}

/* Version & Stepper Bar */
.bp-version-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px;
    margin-bottom: 8px;
    background-color: rgba(0, 0, 0, 0.22);
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
}

.bp-version-group {
    flex-direction: row;
    align-items: center;
}

.bp-version-label {
    font-size: 11px;
    color: #aaaaaa;
    margin-right: 6px;
}

.bp-version-val {
    font-size: 12px;
    -unity-font-style: bold;
    color: #3498db;
    margin-right: 8px;
}

.bp-step-btn {
    width: 22px;
    height: 20px;
    font-size: 11px;
    -unity-font-style: bold;
    padding: 0;
    margin-left: 2px;
}

/* Tab Bar */
.bp-tab-bar {
    flex-direction: row;
    margin-bottom: 12px;
    background-color: #1e1e24;
    border-width: 1px;
    border-color: #2e2e38;
    border-radius: 6px;
    padding: 3px;
    flex-shrink: 0;
}

.bp-tab-button {
    flex-grow: 1;
    height: 32px;
    border-radius: 4px;
    border-width: 0;
    background-color: transparent;
    color: #a0a0a8;
    font-size: 11px;
    -unity-font-style: bold;
    padding: 4px 6px;
    margin: 0 2px;
    transition-property: background-color, color;
    transition-duration: 0.15s;
}

.bp-tab-button:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}

.bp-tab-button--active {
    background-color: #2b3d5b;
    color: #ffffff;
    border-width: 1px;
    border-color: #3d5880;
    border-bottom-width: 2px;
    border-bottom-color: #3498db;
}

/* Cards */
.bp-subcard {
    background-color: rgba(0, 0, 0, 0.16);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 8px 12px;
    margin-bottom: 8px;
}

.bp-card {
    background-color: rgba(0, 0, 0, 0.18);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 10px 12px;
    margin-bottom: 8px;
}

.bp-card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.bp-card-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #ffffff;
}

.bp-card-subtitle {
    font-size: 11px;
    color: #888888;
    margin-bottom: 8px;
    white-space: normal;
}

/* Action Rows */
.bp-actions-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 6px;
    margin-bottom: 4px;
}

.bp-btn {
    height: 26px;
    padding: 0 12px;
    font-size: 11px;
    -unity-font-style: bold;
    border-radius: 4px;
    margin-right: 6px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.08);
    color: #e0e0e0;
}

.bp-btn:hover {
    background-color: rgba(255, 255, 255, 0.16);
    color: #ffffff;
}

.bp-btn--primary {
    background-color: #2980b9;
    border-color: #3498db;
    color: #ffffff;
}

.bp-btn--primary:hover {
    background-color: #3498db;
}

.bp-btn--success {
    background-color: #27ae60;
    border-color: #2ecc71;
    color: #ffffff;
}

.bp-btn--success:hover {
    background-color: #2ecc71;
}

.bp-btn--danger {
    background-color: #c0392b;
    border-color: #e74c3c;
    color: #ffffff;
}

.bp-btn--danger:hover {
    background-color: #e74c3c;
}

/* Badges */
.bp-badge {
    padding: 2px 7px;
    border-radius: 3px;
    font-size: 10px;
    -unity-font-style: bold;
}

.bp-badge--ok {
    background-color: rgba(46, 204, 113, 0.2);
    color: #2ecc71;
    border-width: 1px;
    border-color: rgba(46, 204, 113, 0.4);
}

.bp-badge--warn {
    background-color: rgba(241, 196, 15, 0.2);
    color: #f1c40f;
    border-width: 1px;
    border-color: rgba(241, 196, 15, 0.4);
}

.bp-badge--fail {
    background-color: rgba(231, 76, 60, 0.2);
    color: #e74c3c;
    border-width: 1px;
    border-color: rgba(231, 76, 60, 0.4);
}

.bp-badge--info {
    background-color: rgba(52, 152, 219, 0.2);
    color: #3498db;
    border-width: 1px;
    border-color: rgba(52, 152, 219, 0.4);
}

/* Callouts */
.bp-callout {
    padding: 8px 10px;
    border-radius: 5px;
    margin-bottom: 8px;
    border-left-width: 3px;
}

.bp-callout--info {
    background-color: rgba(52, 152, 219, 0.1);
    border-left-color: #3498db;
}

.bp-callout--warn {
    background-color: rgba(241, 196, 15, 0.1);
    border-left-color: #f1c40f;
}

.bp-callout--ok {
    background-color: rgba(46, 204, 113, 0.1);
    border-left-color: #2ecc71;
}

.bp-callout-text {
    font-size: 11px;
    color: #dddddd;
    white-space: normal;
}

/* Tables */
.bp-table-row {
    flex-direction: row;
    align-items: center;
    padding: 5px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.04);
}

.bp-table-row:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.bp-table-header {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    background-color: rgba(0, 0, 0, 0.3);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.bp-table-header-cell {
    font-size: 11px;
    -unity-font-style: bold;
    color: #aaaaaa;
}

/* Quick Build Grid */
.bp-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.bp-quick-card {
    width: 230px;
    padding: 8px 10px;
    margin-right: 8px;
    margin-bottom: 8px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    align-items: flex-start;
}

.bp-quick-card:hover {
    background-color: rgba(52, 152, 219, 0.18);
    border-color: rgba(52, 152, 219, 0.4);
}

.bp-quick-card--highlight {
    background-color: rgba(39, 174, 96, 0.18);
    border-color: rgba(39, 174, 96, 0.45);
}

.bp-quick-card--highlight:hover {
    background-color: rgba(39, 174, 96, 0.32);
    border-color: #2ecc71;
}

.bp-quick-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #ffffff;
    margin-bottom: 3px;
}

.bp-quick-subtitle {
    font-size: 10px;
    color: #999999;
}

/* Code Console Box */
.bp-code-box {
    background-color: #181818;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    padding: 8px 10px;
    font-size: 11px;
    color: #a6e22e;
    white-space: normal;
    margin-top: 6px;
    margin-bottom: 6px;
}


/* ───────────── 2.0 shell: sidebar window ───────────── */

.bp-window {
    flex-grow: 1;
    padding: 8px 10px;
}

.bp-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.bp-sidebar {
    width: 178px;
    flex-shrink: 0;
    padding: 6px 4px;
    margin-right: 10px;
    background-color: rgba(0, 0, 0, 0.22);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
}

.bp-nav-group {
    font-size: 10px;
    -unity-font-style: bold;
    color: #7f8794;
    margin: 10px 8px 3px 8px;
    letter-spacing: 1px;
}

.bp-nav-item {
    height: 28px;
    margin: 1px 2px;
    padding: 0 8px;
    justify-content: flex-start;
    -unity-text-align: middle-left;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
    color: #c9ced6;
    font-size: 12px;
}

.bp-nav-item:hover {
    background-color: rgba(255, 255, 255, 0.07);
    color: #ffffff;
}

.bp-nav-item--active {
    background-color: rgba(52, 152, 219, 0.28);
    border-left-width: 3px;
    border-left-color: #3498db;
    color: #ffffff;
    -unity-font-style: bold;
}

.bp-nav-footer {
    font-size: 10px;
    color: #7f8794;
    margin: 6px 8px;
    white-space: normal;
}

.bp-content {
    flex-grow: 1;
    flex-shrink: 1;
}

.bp-content-inner {
    padding-right: 6px;
    padding-bottom: 20px;
}

/* Health bar */
.bp-health {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    padding: 4px 6px;
    margin-bottom: 8px;
    border-radius: 5px;
    border-width: 1px;
}

.bp-health--ok { background-color: rgba(46, 204, 113, 0.10); border-color: rgba(46, 204, 113, 0.30); }
.bp-health--warn { background-color: rgba(241, 196, 15, 0.10); border-color: rgba(241, 196, 15, 0.35); }
.bp-health--error { background-color: rgba(231, 76, 60, 0.14); border-color: rgba(231, 76, 60, 0.45); }

.bp-health-chip {
    height: 22px;
    margin: 1px 3px;
    padding: 0 8px;
    font-size: 11px;
    border-radius: 11px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(0, 0, 0, 0.25);
    color: #e6e6e6;
}

.bp-health-chip:hover { background-color: rgba(255, 255, 255, 0.12); }

/* Sub tabs */
.bp-subtabs {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.bp-subtab {
    height: 26px;
    margin: 0 2px -1px 0;
    padding: 0 10px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #aab0ba;
}

.bp-subtab:hover { color: #ffffff; }

.bp-subtab--active {
    color: #ffffff;
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-bottom-color: #3498db;
}

/* Master / detail */
.bp-split {
    flex-direction: row;
    align-items: flex-start;
}

.bp-split-list {
    width: 240px;
    flex-shrink: 0;
    margin-right: 10px;
    padding: 6px;
    background-color: rgba(0, 0, 0, 0.18);
    border-radius: 6px;
}

.bp-split-detail {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.bp-list-item {
    height: 24px;
    margin: 1px 0;
    padding: 0 6px;
    -unity-text-align: middle-left;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    color: #d5d9e0;
    font-size: 11px;
}

.bp-list-item:hover { background-color: rgba(255, 255, 255, 0.07); }

.bp-list-item--active {
    background-color: rgba(52, 152, 219, 0.30);
    color: #ffffff;
    -unity-font-style: bold;
}

.bp-detail-header {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    padding: 8px 10px;
    margin-bottom: 8px;
    border-radius: 6px;
    background-color: rgba(52, 152, 219, 0.10);
    border-width: 1px;
    border-color: rgba(52, 152, 219, 0.30);
}

.bp-group-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #8fb8de;
    margin: 8px 0 3px 0;
}

/* Profile rows (Build section) */
.bp-profile-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    margin-bottom: 2px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.03);
}

.bp-profile-row:hover { background-color: rgba(255, 255, 255, 0.07); }

.bp-profile-row--hidden { opacity: 0.55; }

.bp-btn--small {
    height: 20px;
    padding: 0 7px;
    margin: 1px 3px 1px 0;
    font-size: 10px;
}

/* Tables (extra) */
.bp-table-cell {
    font-size: 11px;
    color: #dddddd;
    padding-right: 6px;
}

.bp-table-row--clickable:hover { background-color: rgba(52, 152, 219, 0.12); }

.bp-table-row--selected { background-color: rgba(52, 152, 219, 0.22); }

/* Define states */
.bp-define--on { color: #7bdc8a; -unity-font-style: bold; }
.bp-define--off { color: #8a8f98; }
.bp-define--removed { color: #f07167; -unity-font-style: bold; }
.bp-define--undocumented { color: #f1c40f; }

/* Usage rows */
.bp-usage-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.04);
}

.bp-usage-row:hover { background-color: rgba(255, 255, 255, 0.04); }

.bp-link {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #5dade2;
    padding: 0 4px;
    margin: 0;
    -unity-text-align: middle-left;
    font-size: 11px;
    flex-shrink: 0;
}

.bp-link:hover { color: #aed6f1; }

.bp-usage-kind {
    width: 150px;
    flex-shrink: 0;
    font-size: 10px;
    color: #a0a6b0;
}

.bp-usage-kind--danger { color: #f07167; -unity-font-style: bold; }

.bp-usage-snippet {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 10px;
    color: #c8ccd2;
    overflow: hidden;
}

.bp-card--focus {
    border-color: rgba(52, 152, 219, 0.55);
    border-width: 1px;
}

/* Output path breakdown */
.bp-path-list {
    margin-top: 6px;
    margin-bottom: 4px;
    padding: 5px 8px;
    background-color: rgba(0, 0, 0, 0.20);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    border-radius: 5px;
}

.bp-path-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 2px;
}

.bp-path-row--final {
    margin-top: 3px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.09);
}

.bp-path-label {
    width: 118px;
    flex-shrink: 0;
    font-size: 10px;
    color: #8f97a3;
}

.bp-path-value {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 11px;
    color: #d8dde5;
    white-space: normal;
}

.bp-path-value--final {
    color: #7bdc8a;
    -unity-font-style: bold;
}

.bp-hint {
    font-size: 10px;
    color: #858c96;
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 6px;
}

/* ───────────── Build confirmation (UI Toolkit modal) ───────────── */

.bp-confirm { flex-grow: 1; }

.bp-confirm-accent { height: 3px; flex-shrink: 0; }

.bp-confirm-hero {
    flex-shrink: 0;
    padding: 14px 18px 12px 16px;
    background-color: rgba(52, 152, 219, 0.08);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.09);
    border-left-width: 3px;
}

.bp-confirm-eyebrow {
    font-size: 9px;
    -unity-font-style: bold;
    color: #5dade2;
    letter-spacing: 2px;
    margin-bottom: 3px;
}

.bp-confirm-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
}

.bp-confirm-title {
    font-size: 19px;
    -unity-font-style: bold;
    color: #ffffff;
}

.bp-confirm-subtitle {
    font-size: 11px;
    color: #98a1ad;
    margin-top: 3px;
    white-space: normal;
}

.bp-confirm-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.bp-confirm-body { padding: 12px 16px 6px 16px; }

.bp-confirm-kv {
    flex-direction: row;
    align-items: flex-start;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.bp-confirm-kv-label {
    width: 86px;
    flex-shrink: 0;
    font-size: 9px;
    -unity-font-style: bold;
    color: #7f8794;
    letter-spacing: 0.6px;
    margin-top: 4px;
}

.bp-confirm-kv-value {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.bp-confirm-value-strong {
    font-size: 12px;
    -unity-font-style: bold;
    color: #f0f3f7;
    margin-right: 8px;
}

.bp-confirm-muted {
    font-size: 11px;
    color: #8b93a0;
    margin-right: 8px;
    white-space: normal;
}

.bp-confirm-path {
    background-color: #17171c;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 5px;
    padding: 8px 10px;
    font-size: 11px;
    color: #7bdc8a;
    white-space: normal;
}

.bp-confirm-inline-actions {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 6px;
}

.bp-confirm-hint-inline {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 10px;
    color: #8b93a0;
    margin-right: 8px;
    white-space: normal;
}

.bp-confirm-define-section { margin-top: 6px; }

.bp-confirm-define-caption {
    font-size: 9px;
    -unity-font-style: bold;
    color: #7f8794;
    letter-spacing: 0.6px;
    margin-bottom: 3px;
}

.bp-chip-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.bp-chip {
    height: 20px;
    margin: 1px 4px 3px 0;
    padding: 0 8px;
    border-radius: 10px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.bp-badge--accent {
    background-color: rgba(155, 89, 182, 0.22);
    color: #c39bd3;
    border-width: 1px;
    border-color: rgba(155, 89, 182, 0.45);
}

.bp-badge--muted {
    background-color: rgba(255, 255, 255, 0.06);
    color: #9aa3af;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}

.bp-callout--fail {
    background-color: rgba(231, 76, 60, 0.12);
    border-left-color: #e74c3c;
}

.bp-confirm-batch-list { margin-top: 2px; }

.bp-confirm-batch-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    padding: 5px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.bp-confirm-batch-row:hover { background-color: rgba(255, 255, 255, 0.04); }

.bp-confirm-batch-index {
    width: 24px;
    flex-shrink: 0;
    font-size: 9px;
    -unity-font-style: bold;
    color: #5dade2;
}

.bp-confirm-batch-more {
    font-size: 10px;
    color: #8b93a0;
    padding: 4px 6px;
}

.bp-confirm-footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 10px 16px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.10);
    background-color: rgba(0, 0, 0, 0.22);
}

.bp-confirm-footer-hint {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 10px;
    color: #8b93a0;
    white-space: normal;
    margin-right: 12px;
}

.bp-confirm-btn {
    height: 30px;
    padding: 0 16px;
    margin: 0 0 0 8px;
    font-size: 12px;
}
